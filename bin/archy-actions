#!/bin/sh
# Actions de pilotage posées depuis le dashboard. Usage : bin/archy-actions [pending|all|ack ID...]
TOKEN="${ARCHY_WRITE_TOKEN:-$( [ -f "$HOME/.archy_write_token" ] && cat "$HOME/.archy_write_token" )}"
URL="${ARCHY_URL:-https://archy-live.pages.dev}/api/actions"
case "$1" in
  ack) shift; B=$(printf '%s\n' "$@" | node -e "const i=require('fs').readFileSync(0,'utf8').split(/\s+/).filter(Boolean);console.log(JSON.stringify({ack:i}))"); curl -s -X POST -H "Authorization: Bearer $TOKEN" -H 'content-type: application/json' -d "$B" "$URL"; echo ;;
  all) curl -s -H "Authorization: Bearer $TOKEN" "$URL"; echo ;;
  *) curl -s -H "Authorization: Bearer $TOKEN" "$URL" | node -e "const a=JSON.parse(require('fs').readFileSync(0,'utf8')).actions||[];console.log(JSON.stringify(a.filter(x=>!x.ack)))" ;;
esac
