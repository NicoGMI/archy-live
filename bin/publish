#!/bin/sh
# Republie l'app complète (build + déploiement Cloudflare Pages). Pour les seules données, voir bin/publish-data.
# Prérequis : CLOUDFLARE_API_TOKEN (Pages: Edit) + CLOUDFLARE_ACCOUNT_ID dans l'environnement, ou `npx wrangler login`.
# Les valeurs peuvent aussi être lues dans ~/.cf_token et ~/.cf_account (hors dépôt).
# Options : --dry (construit et vérifie sans déployer)
set -e
[ -z "$CLOUDFLARE_API_TOKEN" ] && [ -f "$HOME/.cf_token" ] && export CLOUDFLARE_API_TOKEN="$(cat "$HOME/.cf_token")"
[ -z "$CLOUDFLARE_ACCOUNT_ID" ] && [ -f "$HOME/.cf_account" ] && export CLOUDFLARE_ACCOUNT_ID="$(cat "$HOME/.cf_account")"
cd "$(dirname "$0")/.."
[ -f public/data/archy-status.json ] || cp public/data/archy-status.example.json public/data/archy-status.json
node -e "const d=JSON.parse(require('fs').readFileSync('public/data/archy-status.json'));if(!d.tasks||!d.universes||!d.log)throw new Error('JSON invalide')"
npm run build >/dev/null
cmp -s public/data/archy-status.json dist/data/archy-status.json || { echo "dist désynchronisé"; exit 1; }
if [ "$1" = "--dry" ]; then echo "dry-run OK (build + JSON valide, rien déployé)"; exit 0; fi
[ -f .publish-project ] && P="$(cat .publish-project)" || P=archy-live
npx wrangler pages deploy dist --project-name "$P" --branch main --commit-dirty=true
echo "publié $(date -Iseconds)"
